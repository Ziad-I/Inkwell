# PostgreSQL
POSTGRES_USER=inkwell
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inkwell_db

# Redis
REDIS_PASSWORD=changeme

# Backend
CORS_ORIGIN=https://your-domain.com
LOG_LEVEL=warn
SNAPSHOT_INTERVAL=60000
SNAPSHOT_RETENTION=3
API_RATE_LIMIT_MAX=100

# Auth (JWT)
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string-access
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Frontend (baked in at build time by Vite)
VITE_BACKEND_API_URL=https://your-domain.com
VITE_BACKEND_WS_URL=https://your-domain.com
